# Stack completo de Armonía. Copia este archivo a .env para personalizarlo.
MUSIC_BIND=127.0.0.1
MUSIC_PORT=8000
MUSIC_UID=1000
MUSIC_GID=1000
MUSIC_IMAGE=armonia:local
MUSIC_APP_NAME=Armonía
# Configura el origen HTTPS público cuando uses un proxy inverso.
MUSIC_PUBLIC_ORIGIN=
MUSIC_COOKIE_SECURE=true
# Permisos opcionales para YouTube, por ejemplo stream,offline,persist.
MUSIC_YOUTUBE_CAPABILITIES=

# Solo para compose.minimo.yaml, con Navidrome propio o externo.
MUSIC_DIR=./runtime/music
ARMONIA_PORT=8000
NAVIDROME_PORT=4533
NAVIDROME_URL=http://navidrome:4533
YTDLP_COOKIES_FILE=
