<?xml version="1.0" encoding="utf-8"?>
<!-- The Compose interface of the Kotlin app. The core (src/main) is shared with the Capacitor app,
     which brings its own entry: android-capacitor/app/src/bridge/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Armonia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
